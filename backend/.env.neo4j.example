# Copy these values to the repository-root .env, or set process environment variables.
# Get the username/password from the Aura instance credentials, not the console login.
NEO4J_URI=neo4j+s://YOUR_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=replace-with-instance-password
NEO4J_DATABASE=neo4j
